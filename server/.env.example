# ===== 服务端配置（复制为 .env 使用）=====
# 监听端口
PORT=3001

# ===== LLM 配置（OpenAI 兼容协议）=====
# 未配置 LLM_API_KEY 时，系统自动进入 Mock 模式（mock:true）
LLM_API_KEY=
# OpenAI 兼容端点，示例：https://api.deepseek.com/v1 或 https://api.openai.com/v1
LLM_BASE_URL=
# 模型名。⚠️ 不同账号/套餐可用模型 ID 不同，务必先查询：
#   curl https://api.deepseek.com/models -H "Authorization: Bearer $LLM_API_KEY"
# 切勿照抄示例——某账号仅返回 deepseek-flash / deepseek-v4-pro，填 deepseek-chat 会直接报错
LLM_MODEL=

# 可选：推理强度（none/low/medium/high），供 o 系/推理模型使用。
# 透传为 /chat/completions 请求体 reasoning_effort 字段；非枚举值自动忽略。
LLM_REASONING_EFFORT=

# 可选：LLM 调用超时（毫秒），默认 30000。
# ⚠️ 推理模型题量越大越慢：count=10 实测约 24s，如遇偶发超时（响应变 mock:true）可调大至 60000。
LLM_TIMEOUT_MS=30000

# 可选：请求体 max_tokens（正整数）。缺省不写入请求体（保持默认行为）。
# 推理模型若把 token 全部消耗在 reasoning_content 导致 content 为空（finish_reason=length），
# 可据此给足输出上限（建议 >=200，尤其用于连通性探测时）。
LLM_MAX_TOKENS=

# ===== 质检/安全（P1-5）=====
# CORS 白名单（逗号分隔多来源）。不配置则全开（开发/演示零配置）；生产同源托管无需配置。
# 示例：CORS_ORIGIN=https://example.com,https://admin.example.com
CORS_ORIGIN=
# 请求体大小上限（express.json limit），默认 1mb。
BODY_LIMIT=1mb

# ===== 题库检索（function calling 数据源，可插拔）=====
# 未配置时，search_question_bank 工具回退内置本地种子题库（无网可跑）。
# 配置后优先联网检索最新题库素材：GET {QUESTION_BANK_API_URL}?module=&difficulty=&topic=&limit=
# 响应格式：{ "items": [ { question, options:{A,B,C,D}, answer, analysis, knowledgePoint, module, difficulty } ] }
# 示例：https://example.com/api/question-bank
QUESTION_BANK_API_URL=