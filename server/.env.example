# ===== 服务端配置（复制为 .env 使用）=====
# 监听端口
PORT=3001

# ===== LLM 配置（OpenAI 兼容协议）=====
# 未配置 LLM_API_KEY 时，系统自动进入 Mock 模式（mock:true）
LLM_API_KEY=
# OpenAI 兼容端点，示例：https://api.deepseek.com/v1 或 https://api.openai.com/v1
LLM_BASE_URL=
# 模型名，示例：deepseek-chat / gpt-4o-mini
LLM_MODEL=

# 可选：推理强度（none/low/medium/high），供 o 系/推理模型使用（如 LLM_MODEL=deepseek-reasoner）。
# 透传为 /chat/completions 请求体 reasoning_effort 字段；非枚举值自动忽略。
LLM_REASONING_EFFORT=

# ===== 题库检索（function calling 数据源，可插拔）=====
# 未配置时，search_question_bank 工具回退内置本地种子题库（无网可跑）。
# 配置后优先联网检索最新题库素材：GET {QUESTION_BANK_API_URL}?module=&difficulty=&topic=&limit=
# 响应格式：{ "items": [ { question, options:{A,B,C,D}, answer, analysis, knowledgePoint, module, difficulty } ] }
# 示例：https://example.com/api/question-bank
QUESTION_BANK_API_URL=